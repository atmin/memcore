#!/bin/sh
# Run by hand after a build: one real sleep pass, with the real Claude Code, over one fixture transcript.
# Usage: scripts/sleep-check
#
# It spends the tokens of two short headless calls, at most 0.50 dollars at API prices. It runs against a
# scratch memory repo under home, so ~/memory stays untouched. It fails unless the pass records both
# corrections of the fixture.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
for flag in --safe-mode --setting-sources --strict-mcp-config --tools --no-session-persistence --json-schema --max-budget-usd; do
	claude --help 2>/dev/null | grep -q -- "$flag" || { echo "sleep-check: claude lacks $flag, so a sleep pass cannot run" >&2; exit 1; }
done

work=$(mktemp -d "$HOME/.memcore-sleep-check.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin" "$work/project"
(cd "$root" && CGO_ENABLED=0 go build -o "$work/bin/memcore" ./cmd/memcore)
PATH="$work/bin:$PATH"
MEMCORE_REPO="$work/memory"
export PATH MEMCORE_REPO
# The check runs as the person: an agent that runs this script still gets a real pass.
unset CLAUDECODE CLAUDE_CODE_SESSION_ID

git init -q --bare -b main "$work/remote.git"
# A dry run builds the memory repo, asks nothing and leaves the settings of Claude Code alone. An empty
# configuration folder keeps your transcripts and your auto-memory out of the scratch repo. Only init gets
# it, so the real agent of the pass stays logged in.
mkdir -p "$work/claude-config"
CLAUDE_CONFIG_DIR="$work/claude-config" memcore init --dry-run "$work/remote.git" >/dev/null
state="$MEMCORE_REPO/.git/memcore"
# A fresh mark of a snapshot keeps the calls below from starting one in the background. Such a snapshot would
# copy your real transcripts into the scratch repo, and it would still write while this script cleans up.
touch "$state/snapshot.started"
cd "$work/project"

# One memory that the session could see. The first correction of the fixture repeats it.
memcore remember >/dev/null <<'MEMORY'
---
name: ask-before-push
description: Read before you push: ask the person first.
type: feedback
---

Push only when the person asks.

**Why:** The person reviews every commit before it leaves the machine.
**How to apply:** Commit, then stop and ask.
MEMORY

commit=$(git -C "$MEMCORE_REPO" rev-parse HEAD)
level=$(tail -n 1 "$state/log.jsonl" | sed -n 's/.*"level":"\([^"]*\)".*/\1/p')
[ -n "$level" ] || { echo "sleep-check: the use log names no level" >&2; exit 1; }

# The times of the fixture are two days old, so the session has ended for a pass.
day=$(date -u -v-2d +%Y-%m-%d 2>/dev/null || date -u -d '2 days ago' +%Y-%m-%d)
session=sleep-check-session
transcript="$work/transcript.jsonl"
cat >"$transcript" <<FIXTURE
{"agent":"claude","session":"$session","dir":"$work/project"}
{"time":"${day}T10:00:00Z","who":"you","text":"Add a retry to the fetch of the feed."}
{"time":"${day}T10:03:00Z","who":"agent","text":"I added the retry with three attempts, committed it and pushed the branch."}
{"time":"${day}T10:04:00Z","who":"you","text":"No. Never push without asking me first."}
{"time":"${day}T10:05:00Z","who":"agent","text":"Sorry. I will ask before I push."}
{"time":"${day}T10:06:00Z","who":"you","text":"And write each commit message in one line, with no body."}
{"time":"${day}T10:07:00Z","who":"agent","text":"Done. The message is one line now."}
FIXTURE

# Commit the fixture onto the transcripts branch, as a snapshot does, and log the start of its session.
blob=$(git -C "$MEMCORE_REPO" hash-object -w "$transcript")
index="$work/transcripts.index"
GIT_INDEX_FILE="$index" git -C "$MEMCORE_REPO" read-tree --empty
GIT_INDEX_FILE="$index" git -C "$MEMCORE_REPO" update-index --add --cacheinfo "100644,$blob,claude/fixture/$session.jsonl"
tree=$(GIT_INDEX_FILE="$index" git -C "$MEMCORE_REPO" write-tree)
snapshot=$(git -C "$MEMCORE_REPO" commit-tree "$tree" -m "snapshot: 1 transcript")
git -C "$MEMCORE_REPO" update-ref refs/heads/transcripts "$snapshot"
printf '{"time":"%sT09:59:00Z","session":"%s","agent":"claude","commit":"%s","level":"%s","command":"hook","hook":"session-start","outcome":"ok"}\n' \
	"$day" "$session" "$commit" "$level" >>"$state/log.jsonl"

echo "== memcore sleep --budget 0.50 --sessions 1"
memcore sleep --budget 0.50 --sessions 1
echo
echo "== memcore sleep --list"
list=$(memcore sleep --list)
printf '%s\n' "$list"
echo
echo "== memcore stats, the line of the misses"
memcore stats | grep 'Misses:' | head -1

status=0
for quote in "Never push without asking me first." "write each commit message in one line, with no body."; do
	case "$list" in
	*"$quote"*) ;;
	*) echo "sleep-check: FAIL, the records lack the correction: $quote" >&2; status=1 ;;
	esac
done
[ "$status" -eq 0 ] && echo "sleep-check: ok, the pass recorded both corrections."
exit "$status"
