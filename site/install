#!/bin/sh
# Installs memcore. It downloads the executable of the latest release for this machine
# into ~/.local/bin, after it checks the SHA-256 against SHA256SUMS of the release.
# It needs no sudo. Read it before you run it: curl -fsSL https://memco.re/install
# The script is one group, which sh reads whole before it runs any of it.
# So a download that stops early runs nothing.
{
set -eu

# fail prints the reason of a failure, and exits.
fail() {
	printf 'memcore install: %s\n' "$1" >&2
	exit 1
}

# target prints the target of this machine, such as darwin-arm64.
target() {
	system=$(uname -s)
	processor=$(uname -m)
	case "$system" in
	Darwin) system=darwin ;;
	Linux) system=linux ;;
	*) fail "memcore has no release for the system $system" ;;
	esac
	case "$processor" in
	arm64 | aarch64) processor=arm64 ;;
	x86_64) processor=amd64 ;;
	*) fail "memcore has no release for the processor $processor" ;;
	esac
	printf '%s-%s\n' "$system" "$processor"
}

# linux_build prints glibc when the loader of the glibc build exists for the processor, and static otherwise.
# The glibc build is for the native window, which will need that loader. The static build runs on any Linux.
linux_build() {
	case "$1" in
	amd64) loader=/lib64/ld-linux-x86-64.so.2 ;;
	arm64) loader=/lib/ld-linux-aarch64.so.1 ;;
	*) echo static; return ;;
	esac
	if [ -e "${MEMCORE_INSTALL_ROOT:-}$loader" ]; then echo glibc; else echo static; fi
}

# sha256 prints the SHA-256 of a file.
sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d ' ' -f 1
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | cut -d ' ' -f 1
	else
		fail "neither sha256sum nor shasum is installed"
	fi
}

main() {
	url=${MEMCORE_RELEASE_URL:-https://github.com/atmin/memcore/releases/latest/download}
	asset=memcore-$(target)
	case "$asset" in
	memcore-linux-*) asset=$asset-$(linux_build "${asset##*-}") ;;
	esac
	tmp=$(mktemp -d)
	stage=
	trap 'rm -rf "$tmp"; if [ -n "$stage" ]; then rm -f "$stage"; fi' EXIT
	trap 'exit 1' HUP INT TERM

	curl -fsSL "$url/$asset" -o "$tmp/$asset" || fail "the download of $url/$asset failed"
	curl -fsSL "$url/SHA256SUMS" -o "$tmp/SHA256SUMS" || fail "the download of $url/SHA256SUMS failed"
	want=$(awk -v name="$asset" '$2 == name { print $1 }' "$tmp/SHA256SUMS")
	[ -n "$want" ] || fail "SHA256SUMS of the release lists no $asset"
	got=$(sha256 "$tmp/$asset")
	[ "$got" = "$want" ] || fail "the SHA-256 of $asset is $got, but SHA256SUMS says $want"

	bin=$HOME/.local/bin
	mkdir -p "$bin"
	[ ! -d "$bin/memcore" ] || fail "$bin/memcore is a folder"
	stage=$(mktemp "$bin/.memcore.XXXXXX")
	cp "$tmp/$asset" "$stage"
	chmod 755 "$stage"
	version=$("$stage" version) || fail "the downloaded memcore does not run on this machine"
	mv -f "$stage" "$bin/memcore"
	stage=
	printf 'Installed memcore in ~/.local/bin: %s\n' "$version"

	case ":$PATH:" in
	*":$bin:"*) ;;
	*) printf 'Put ~/.local/bin on PATH, in the profile of your shell.\n' ;;
	esac
	printf 'Set up a machine with: memcore init <remote>\n'
}

main "$@"
}
